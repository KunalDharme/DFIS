# Pick ONE LLM option (leave LLM_PROVIDER empty for rule-based analysis)
LLM_PROVIDER=ollama            # anthropic | openai | ollama
LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=                 # needed for anthropic/openai
DEV_SHOW_OTP=1                 # show the verification code in the UI (demo). Set 0 once email sending is added.
# Optional Pro-preview provider. Keep the token only in local .env, never in source control.
# LEAKOSINT_TOKEN=
# Optional auth database path. Defaults to backend/dfis_auth.sqlite3.
# DFIS_AUTH_DB=
# Set to 1 only when serving DFIS over HTTPS.
# COOKIE_SECURE=0
